   "source": [
    "## SECTION 10: Advanced Feature Selection & Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SECTION 10: ADVANCED FEATURE SELECTION & IMPORTANCE\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"FEATURE SELECTION & IMPORTANCE ANALYSIS\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Prepare data for feature selection\n",
    "X_train = partitions[\"train\"][FEATURE_COLUMNS].copy()\n",
    "y_train = partitions[\"train\"][\"rul\"].copy()\n",
    "X_val = partitions[\"validation\"][FEATURE_COLUMNS].copy()\n",
    "y_val = partitions[\"validation\"][\"rul\"].copy()\n",
    "X_test = partitions[\"test\"][FEATURE_COLUMNS].copy()\n",
    "y_test = partitions[\"test\"][\"rul\"].copy()\n",
    "\n",
    "# Standardize features\n",
    "scaler = StandardScaler()\n",
    "X_train_scaled = scaler.fit_transform(X_train)\n",
    "X_val_scaled = scaler.transform(X_val)\n",
    "X_test_scaled = scaler.transform(X_test)\n",
    "\n",
    "# Feature selection with SelectKBest\n",
    "selector = SelectKBest(f_regression, k=min(35, len(FEATURE_COLUMNS)))\n",
    "X_train_selected = selector.fit_transform(X_train_scaled, y_train)\n",
    "\n",
    "selected_features = np.array(FEATURE_COLUMNS)[selector.get_support()]\nscores = selector.scores_[selector.get_support()]\n\nprint(f\"\\n✓ Feature Selection:\")\nprint(f\"  Original features: {len(FEATURE_COLUMNS)}\")\nprint(f\"  Selected features: {len(selected_features)}\")\nprint(f\"\\nTop 15 Features (by F-score):\")\ntop_indices = np.argsort(scores)[::-1][:15]\nfor i, idx in enumerate(top_indices, 1):\n",
    "    print(f\"  {i:2d}. {selected_features[idx]:30s}: {scores[idx]:8.2f}\")\n\n# Update feature list\nFEATURE_COLUMNS_SELECTED = list(selected_features)\nprint(f\"\\n✓ Updated feature set: {len(FEATURE_COLUMNS_SELECTED)} features\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## SECTION 11-12: Data Imbalance Mitigation & Cross-Validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SECTIONS 11-12: IMBALANCE MITIGATION & CROSS-VALIDATION\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"IMBALANCE MITIGATION & MODEL VALIDATION\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Calculate class weights\n",
    "train_labeled_full = partitions['train'].copy()\n",
    "if 'rul_phase' not in train_labeled_full.columns:\n",
    "    train_labeled_full['rul_phase'] = pd.cut(\n",
    "        train_labeled_full['rul'],\n",
    "        bins=[0, 25, 50, 100, 125],\n",
    "        labels=['Critical', 'Degraded', 'Degrading', 'Healthy'],\n",
    "        include_lowest=True\n",
    "    )\n",
    "\nphase_counts = train_labeled_full['rul_phase'].value_counts()\ntotal_samples = len(train_labeled_full)\nnum_phases = len(phase_counts)\n\nclass_weights = (total_samples / (num_phases * phase_counts)).sort_index()\ntrain_labeled_full['sample_weight'] = train_labeled_full['rul_phase'].map(class_weights)\n\nprint(\"\\n✓ Class Weights (for weighted loss):\")\nfor phase, weight in class_weights.items():\n",
    "    print(f\"  {phase:15s}: {weight:.2f}x\")\n\n# Stratified resampling\nprint(\"\\n✓ Stratified Resampling:\")\ncritical = train_labeled_full[train_labeled_full['rul_phase'] == 'Critical']\ndegraded = train_labeled_full[train_labeled_full['rul_phase'] == 'Degraded']\ndegrading = train_labeled_full[train_labeled_full['rul_phase'] == 'Degrading']\nhealthy = train_labeled_full[train_labeled_full['rul_phase'] == 'Healthy']\n\ntarget_critical = 1500\ntarget_degraded = 1500\ntarget_degrading = len(degrading)\ntarget_healthy = int(len(healthy) * 0.6)\n\nprint(f\"  Critical:    {len(critical):5d} → {target_critical:5d}\")\nprint(f\"  Degraded:    {len(degraded):5d} → {target_degraded:5d}\")\nprint(f\"  Degrading:   {len(degrading):5d} → {target_degrading:5d}\")\nprint(f\"  Healthy:     {len(healthy):5d} → {target_healthy:5d}\")\n\n# Resample\nnp.random.seed(RANDOM_SEED)\ncritical_resampled = resample(critical, n_samples=target_critical, replace=True, random_state=RANDOM_SEED)\ndegraded_resampled = resample(degraded, n_samples=target_degraded, replace=True, random_state=RANDOM_SEED)\nhealthy_resampled = resample(healthy, n_samples=target_healthy, replace=False, random_state=RANDOM_SEED)\n\ntrain_balanced = pd.concat([\n",
    "    critical_resampled,\n",
    "    degraded_resampled,\n",
    "    degrading,\n",
    "    healthy_resampled\n",
    "]).reset_index(drop=True)\n\ntrain_balanced = train_balanced.sample(frac=1, random_state=RANDOM_SEED).reset_index(drop=True)\nprint(f\"\\nBalanced training set size: {len(train_balanced)} (vs original {len(train_labeled_full)})\")\n\n# Prepare balanced data\nX_train_balanced = train_balanced[FEATURE_COLUMNS_SELECTED]\ny_train_balanced = train_balanced['rul']\nX_train_balanced_scaled = scaler.transform(X_train_balanced)\n\n# Cross-validation\nprint(\"\\n✓ Cross-Validation Setup:\")\nkfold = KFold(n_splits=5, shuffle=True, random_state=RANDOM_SEED)\nprint(f\"  5-fold cross-validation configured\")"
   ]
