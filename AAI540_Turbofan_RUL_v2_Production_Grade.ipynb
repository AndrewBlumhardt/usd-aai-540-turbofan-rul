    "    best_model = xgb_v1\n",
    "    best_model_name = \"v1 (Baseline)\"\n",
    "\n",
    "print(f\"\\n✓ BEST MODEL: {best_model_name} (RMSE: {best_rmse:.2f} cycles)\")"
