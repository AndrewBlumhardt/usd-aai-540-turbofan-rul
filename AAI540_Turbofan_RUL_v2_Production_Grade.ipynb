    "## SECTION 3-4: Data Retrieval & Validation with Integrity Checks"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# SECTIONS 3-4: DATA RETRIEVAL, VALIDATION & INTEGRITY CHECKS\n",
    "\n",
    "from urllib.request import urlretrieve\n",
    "from io import BytesIO\n",
    "import zipfile\n",
    "import shutil\n",
    "import hashlib\n",
    "\n",
    "LOCAL_ROOT = Path(\"aai540_turbofan_v2_prod\")\n",
    "RAW_DIR = LOCAL_ROOT / \"raw\" / \"FD001\"\n",
    "PROCESSED_DIR = LOCAL_ROOT / \"processed\"\n",
    "OUTPUT_DIR = LOCAL_ROOT / \"outputs\"\n",
    "METADATA_DIR = LOCAL_ROOT / \"metadata\"\n",
    "\n",
    "for directory in (RAW_DIR, PROCESSED_DIR, OUTPUT_DIR, METADATA_DIR):\n",
    "    directory.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"DATA RETRIEVAL & INTEGRITY VALIDATION\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Download NASA dataset\n",
    "PUBLIC_ARCHIVE_URL = \"https://phm-datasets.s3.amazonaws.com/NASA/6.+Turbofan+Engine+Degradation+Simulation+Data+Set.zip\"\n",
    "REQUIRED_FILES = (\"train_FD001.txt\", \"test_FD001.txt\", \"RUL_FD001.txt\")\n",
    "\n",
    "def files_available(directory):\n",
    "    return all((directory / filename).exists() for filename in REQUIRED_FILES)\n",
    "\n",
    "def compute_file_hash(filepath):\n",
    "    \"\"\"Compute SHA256 hash for integrity verification\"\"\"\n",
    "    sha256_hash = hashlib.sha256()\n",
    "    with open(filepath, \"rb\") as f:\n",
    "        for byte_block in iter(lambda: f.read(4096), b\"\"):\n",
    "            sha256_hash.update(byte_block)\n",
    "    return sha256_hash.hexdigest()\n",
    "\n",
    "if files_available(RAW_DIR):\n",
    "    print(\"✓ Using cached FD001 files\")\nelse:\n",
    "    print(\"Downloading NASA archive...\")\n",
    "    archive_path = RAW_DIR / \"cmapss_turbofan.zip\"\n",
    "    urlretrieve(PUBLIC_ARCHIVE_URL, archive_path)\n",
    "    print(\"✓ Archive downloaded\")\n",
    "\n",
    "# Compute and log file hashes\nprint(\"\\n✓ File Integrity Check:\")\nfile_hashes = {}\nfor filename in REQUIRED_FILES:\n",
    "    path = RAW_DIR / filename\n",
    "    file_hash = compute_file_hash(path)\n",
    "    file_size = path.stat().st_size\n",
    "    file_hashes[filename] = file_hash\n",
    "    print(f\"  {filename:20s}: {file_size:10,d} bytes\")\n\n# Save metadata\ndata_metadata = {\n",
    "    \"source\": \"NASA C-MAPSS FD001\",\n",
    "    \"download_date\": datetime.now().isoformat(),\n",
    "    \"files\": {\n",
    "        filename: {\n",
    "            \"size_bytes\": (RAW_DIR / filename).stat().st_size,\n",
    "            \"sha256_hash\": file_hashes[filename]\n",
    "        }\n",
    "        for filename in REQUIRED_FILES\n",
    "    }\n",
    "}\n\nwith open(METADATA_DIR / \"data_metadata.json\", \"w\") as f:\n",
    "    json.dump(data_metadata, f, indent=2)\n\nprint(\"✓ Metadata saved to\", METADATA_DIR / \"data_metadata.json\")"
   ]
