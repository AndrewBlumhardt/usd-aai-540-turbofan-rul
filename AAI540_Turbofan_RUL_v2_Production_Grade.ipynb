    "# SECTION 16: DRIFT DETECTION & PRODUCTION MONITORING\n",
    "\n",
    "from scipy.stats import ks_2samp\n",
    "\n",
    "print(\"\\n\" + \"=\"*80)\n",
    "print(\"DATA DRIFT & PRODUCTION MONITORING SETUP\")\n",
    "print(\"=\"*80)\n",
    "\n",
    "# Detect data drift\n",
    "def detect_data_drift(baseline_df, current_df, threshold=0.05):\n",
    "    \"\"\"Statistical drift detection using KS test\"\"\"\n",
    "    drift_results = {}\n",
    "    \n",
    "    for column in baseline_df.columns:\n",
    "        if column not in current_df.columns:\n",
    "            continue\n",
    "        \n",
    "        statistic, p_value = ks_2samp(baseline_df[column], current_df[column])\n",
    "        drift_detected = p_value < threshold\n",
    "        \n",
    "        if column in FEATURE_COLUMNS_SELECTED[:10]:  # Check sample features\n",
    "            drift_results[column] = {\n",
    "                'p_value': p_value,\n",
    "                'drift_detected': drift_detected,\n",
    "                'baseline_mean': baseline_df[column].mean(),\n",
    "                'current_mean': current_df[column].mean(),\n",
    "                'mean_shift_pct': ((current_df[column].mean() - baseline_df[column].mean()) / \n",
    "                                   baseline_df[column].mean() * 100) if baseline_df[column].mean() != 0 else 0\n",
    "            }\n",
    "    \n",
    "    return drift_results\n",
    "\n# Test drift detection\ndrift_report = detect_data_drift(\n",
    "    partitions['train'][FEATURE_COLUMNS_SELECTED],\n",
    "    partitions['test'][FEATURE_COLUMNS_SELECTED]\n",
    ")\n",
    "\nprint(\"\\n✓ Data Drift Report (Test vs Train):\")\nfor feature, results in list(drift_report.items())[:10]:\n",
    "    status = \"⚠️  DRIFT\" if results['drift_detected'] else \"✓ Stable\"\n",
    "    print(f\"  {status} {feature:30s}: {results['mean_shift_pct']:+6.1f}%\")\n",
    "\n# Model performance metrics\nmodel_metrics = {\n",
    "    \"timestamp\": datetime.now().isoformat(),\n",
    "    \"model_version\": \"2.0\",\n",
    "    \"test_rmse\": rmse_v2a,\n",
    "    \"test_mae\": mae_v2a,\n",
    "    \"r2_score\": r2_v2a,\n",
    "    \"improvement_vs_v1\": ((20.10 - rmse_v2a) / 20.10 * 100),\n",
    "    \"training_samples\": len(train_balanced),\n",
    "    \"selected_features\": len(FEATURE_COLUMNS_SELECTED)\n",
    "}\n",
    "\nwith open(METADATA_DIR / \"model_metrics.json\", \"w\") as f:\n",
    "    json.dump(model_metrics, f, indent=2)\n",
    "\nprint(f\"\\n✓ Model metrics logged to metadata\")\n\n# CloudWatch publishing\nif PUBLISH_TO_CLOUDWATCH:\n",
    "    print(f\"\\n✓ Publishing to CloudWatch...\")\n",
    "    try:\n",
    "        cloudwatch.put_metric_data(\n",
    "            Namespace='TurbofanRUL',\n",
    "            MetricData=[\n",
    "                {'MetricName': 'ModelRMSE', 'Value': rmse_v2a, 'Unit': 'None'},\n",
    "                {'MetricName': 'ModelMAE', 'Value': mae_v2a, 'Unit': 'None'},\n",
    "                {'MetricName': 'R2Score', 'Value': r2_v2a, 'Unit': 'None'}\n",
    "            ]\n",
    "        )\n",
    "        print(f\"  ✓ Metrics published to CloudWatch\")\n",
    "    except:\n",
    "        print(f\"  (CloudWatch publish skipped in notebook environment)\")"
