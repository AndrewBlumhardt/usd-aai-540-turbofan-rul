    "X_val_selected = X_val_scaled[:, selector.get_support()]\n",
    "X_test_selected = X_test_scaled[:, selector.get_support()]\n",
    "\n",
    "# Model 1: Baseline XGBoost (V1 reproduction)\n",
    "print(\"\\n[Model 1] XGBoost Baseline (V1 reproduction)\")\nxgb_v1 = XGBRegressor(\n",
    "    objective='reg:squarederror',\n",
    "    n_estimators=200,\n",
    "    max_depth=4,\n",
    "    learning_rate=0.05,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
