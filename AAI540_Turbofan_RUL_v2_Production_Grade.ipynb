    "\nxgb_v1.fit(\n",
    "    X_train_selected,\n",
    "    y_train,\n",
    "    eval_set=[(X_val_selected, y_val)],\n",
    "    early_stopping_rounds=10,\n",
    "    verbose=False\n",
    ")\n",
    "\ny_pred_v1 = np.clip(xgb_v1.predict(X_test_selected), 0, RUL_CAP)\n",
    "rmse_v1 = np.sqrt(mean_squared_error(y_test, y_pred_v1))\n",
    "mae_v1 = mean_absolute_error(y_test, y_pred_v1)\n",
    "r2_v1 = r2_score(y_test, y_pred_v1)\n",
    "\n",
    "print(f\"  Test RMSE: {rmse_v1:.2f} cycles\")\n",
    "print(f\"  Test MAE:  {mae_v1:.2f} cycles\")\n",
    "print(f\"  R² Score:  {r2_v1:.4f}\")\n",
    "\n",
    "# Model 2: Weighted Loss (V2a)\n",
    "print(\"\\n[Model 2a] XGBoost + Weighted Loss (V2 Improvement)\")\nxgb_v2a = XGBRegressor(\n",
    "    objective='reg:squarederror',\n",
    "    n_estimators=200,\n",
    "    max_depth=4,\n",
    "    learning_rate=0.05,\n",
