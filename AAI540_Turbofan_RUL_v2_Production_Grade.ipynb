    "    X_train_selected,\n",
    "    y_train,\n",
    "    sample_weight=train_labeled_full['sample_weight'].values,\n",
    "    eval_set=[(X_val_selected, y_val)],\n",
    "    early_stopping_rounds=10,\n",
    "    verbose=False\n",
    ")\n",
    "\ny_pred_v2a = np.clip(xgb_v2a.predict(X_test_selected), 0, RUL_CAP)\n",
    "rmse_v2a = np.sqrt(mean_squared_error(y_test, y_pred_v2a))\n",
    "mae_v2a = mean_absolute_error(y_test, y_pred_v2a)\n",
    "r2_v2a = r2_score(y_test, y_pred_v2a)\n",
    "\n",
    "print(f\"  Test RMSE: {rmse_v2a:.2f} cycles ({((20.10 - rmse_v2a) / 20.10 * 100):+.1f}% vs v1)\")\n",
    "print(f\"  Test MAE:  {mae_v2a:.2f} cycles\")\n",
    "print(f\"  R² Score:  {r2_v2a:.4f}\")\n",
    "\n",
    "# Model 3: Stratified Resampling (V2b)\n",
    "print(\"\\n[Model 2b] XGBoost + Stratified Resampling (V2 Alternative)\")\nxgb_v2b = XGBRegressor(\n",
    "    objective='reg:squarederror',\n",
    "    n_estimators=200,\n",
    "    max_depth=4,\n",
    "    learning_rate=0.05,\n",
    "    subsample=0.8,\n",
    "    colsample_bytree=0.8,\n",
    "    random_state=RANDOM_SEED,\n",
    "    verbosity=0\n",
    ")\n",
    "\nxgb_v2b.fit(\n",
    "    X_train_balanced_scaled[:, selector.get_support()],\n",
    "    y_train_balanced,\n",
    "    eval_set=[(X_val_selected, y_val)],\n",
    "    early_stopping_rounds=10,\n",
    "    verbose=False\n",
    ")\n",
    "\ny_pred_v2b = np.clip(xgb_v2b.predict(X_test_selected), 0, RUL_CAP)\n",
    "rmse_v2b = np.sqrt(mean_squared_error(y_test, y_pred_v2b))\n",
    "mae_v2b = mean_absolute_error(y_test, y_pred_v2b)\n",
    "r2_v2b = r2_score(y_test, y_pred_v2b)\n",
    "\n",
    "print(f\"  Test RMSE: {rmse_v2b:.2f} cycles ({((20.10 - rmse_v2b) / 20.10 * 100):+.1f}% vs v1)\")\n",
    "print(f\"  Test MAE:  {mae_v2b:.2f} cycles\")\n",
    "print(f\"  R² Score:  {r2_v2b:.4f}\")\n",
    "\n# Select best model\nbest_rmse = min(rmse_v1, rmse_v2a, rmse_v2b)\nif best_rmse == rmse_v2a:\n",
    "    best_model = xgb_v2a\n",
    "    best_model_name = \"v2a (Weighted Loss)\"\nelif best_rmse == rmse_v2b:\n",
